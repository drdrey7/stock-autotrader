FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json* tsconfig.base.json ./
COPY packages/contracts ./packages/contracts
COPY apps/api ./apps/api
COPY database ./database
RUN npm ci
EXPOSE 8787
CMD ["npm", "run", "dev", "-w", "@stock-autotrader/api", "--", "--ip", "0.0.0.0", "--port", "8787"]

