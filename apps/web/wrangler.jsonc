{
  "name": "stock-autotrader-web",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  "vars": {
    "ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://stock-autotrader-web.barroso-labs.workers.dev"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/healthz",
      "/healthz/*",
      "/ingest/*",
      "/__internal/*"
    ]
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "0 6 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stock-autotrader-db",
      "database_id": "b5a7f345-f5ec-4200-ab41-0a37a01560f2",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AI_ANALYSIS_QUEUE",
        "queue": "stock-autotrader-ai-analysis"
      }
    ]
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
