{
  "name": "stock-autotrader-web",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": [
      "*/15 * * * mon-fri",
      "0 14,19 * * mon-fri"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stock-autotrader-db",
      "database_id": "b5a7f345-f5ec-4200-ab41-0a37a01560f2",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
