{
  "name": "@stock-autotrader/api",
  "version": "5.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/index.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf:types": "wrangler types worker-configuration.d.ts",
    "cf:check": "wrangler deploy --dry-run --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply stock-autotrader-public --local"
  },
  "dependencies": {
    "@stock-autotrader/contracts": "*",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.120.0"
  }
}
