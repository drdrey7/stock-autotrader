<div class="nebula-scene" data-nebula-scene aria-hidden="true">
  <canvas class="nebula-canvas"></canvas>
  <div class="nebula-fallback"></div>
</div>

<script>
  const scenes = document.querySelectorAll<HTMLElement>("[data-nebula-scene]");
  const vertex = `attribute vec2 p; void main(){gl_Position=vec4(p,0.,1.);}`;
  const fragment = `precision highp float;
    uniform vec2 r; uniform float t; uniform vec2 m;
    float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
    float noise(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(hash(i),hash(i+vec2(1.,0.)),f.x),mix(hash(i+vec2(0.,1.)),hash(i+vec2(1.,1.)),f.x),f.y);}
    float fbm(vec2 p){float v=0.,a=.5;for(int i=0;i<5;i++){v+=a*noise(p);p=p*2.03+vec2(13.1,7.7);a*=.5;}return v;}
    void main(){vec2 uv=(gl_FragCoord.xy-.5*r)/r.y; uv.x*=1.35; vec2 drift=vec2(t*.004,-t*.002)+m*.035;
      float cloud=fbm(uv*2.3+drift)+.45*fbm(uv*5.2-drift*1.4); float band=exp(-pow((uv.y+uv.x*.10)*2.4,2.));
      float star=step(.992,hash(floor((uv+drift)*r.y*.13)))*(.4+.6*hash(floor((uv+drift)*r.y*.13)+3.));
      float horizon=exp(-pow((uv.y-.30+abs(uv.x)*.10)*8.,2.)); float edge=smoothstep(.88,.18,length(uv*vec2(.72,.64)));
      vec3 neb=vec3(.015,.16,.25)*cloud + vec3(.02,.65,.68)*cloud*band + vec3(.08,.3,.85)*cloud*.38;
      vec3 planet=vec3(.005,.025,.05)*horizon + vec3(.03,.18,.24)*horizon*horizon;
      vec3 glow=vec3(.12,.92,1.)*exp(-pow((uv.y-.30+abs(uv.x)*.10)*22.,2.))*edge;
      vec3 col=neb+planet+glow+vec3(.65,.95,1.)*star; col*=smoothstep(1.18,.12,length(uv*vec2(.72,.66))); gl_FragColor=vec4(col,1.); }`;
  function start(root: HTMLElement) {
    const canvas = root.querySelector("canvas") as HTMLCanvasElement;
    const gl = canvas.getContext("webgl", { alpha: true, antialias: false });
    if (!gl) return;
    const compile = (type: number, source: string) => { const shader = gl.createShader(type)!; gl.shaderSource(shader, source); gl.compileShader(shader); return shader; };
    const program = gl.createProgram()!; gl.attachShader(program, compile(gl.VERTEX_SHADER, vertex)); gl.attachShader(program, compile(gl.FRAGMENT_SHADER, fragment)); gl.linkProgram(program); gl.useProgram(program);
    const buffer = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buffer); gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1,3,-1,-1,3]), gl.STATIC_DRAW);
    const p = gl.getAttribLocation(program, "p"); gl.enableVertexAttribArray(p); gl.vertexAttribPointer(p, 2, gl.FLOAT, false, 0, 0);
    const resolution = gl.getUniformLocation(program, "r"); const time = gl.getUniformLocation(program, "t"); const mouse = gl.getUniformLocation(program, "m");
    let px = 0, py = 0, tx = 0, ty = 0, raf = 0, started = false; const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const resize = () => { const box = root.getBoundingClientRect(); const dpr = Math.min(devicePixelRatio || 1, 1.5); canvas.width = Math.max(1, Math.floor(box.width*dpr)); canvas.height = Math.max(1, Math.floor(box.height*dpr)); gl.viewport(0,0,canvas.width,canvas.height); gl.uniform2f(resolution,canvas.width,canvas.height); };
    const draw = (stamp = 0) => { px += (tx-px)*.035; py += (ty-py)*.035; gl.uniform1f(time, stamp); gl.uniform2f(mouse,px,py); gl.drawArrays(gl.TRIANGLES,0,3); if (!reduced) raf=requestAnimationFrame(draw); };
    const onMove = (event: PointerEvent) => { const box=root.getBoundingClientRect(); tx=(event.clientX-box.left)/box.width-.5; ty=(event.clientY-box.top)/box.height-.5; };
    root.addEventListener("pointermove", onMove, { passive:true }); addEventListener("resize",resize,{passive:true}); resize(); draw(); started=true;
    return () => { if (started) cancelAnimationFrame(raf); root.removeEventListener("pointermove",onMove); };
  }
  scenes.forEach(start);
</script>
