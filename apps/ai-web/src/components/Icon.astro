---
interface Props { name: "arrow" | "menu" | "user" | "sun" | "moon" | "spark" | "market" | "fundamentals" | "news" | "debate"; size?: number; }
const { name, size = 20 } = Astro.props;
const paths = {
  arrow: '<path d="M4 12h15M13 6l6 6-6 6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  user: '<circle cx="12" cy="8" r="3.25"/><path d="M5.5 20c.8-3.25 3.1-4.9 6.5-4.9s5.7 1.65 6.5 4.9"/>',
  sun: '<circle cx="12" cy="12" r="3.5"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>',
  moon: '<path d="M20.4 15.1A8.5 8.5 0 0 1 8.9 3.6 8.5 8.5 0 1 0 20.4 15.1Z"/>',
  spark: '<path d="m12 2 1.55 6.45L20 10l-6.45 1.55L12 18l-1.55-6.45L4 10l6.45-1.55L12 2Z"/><path d="m19 16 .62 2.38L22 19l-2.38.62L19 22l-.62-2.38L16 19l2.38-.62L19 16Z"/>',
  market: '<path d="M4 19V5M4 17l5-5 3 3 7-8"/><path d="M15 7h4v4"/>',
  fundamentals: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 17v-4M12 17V8M16 17v-7"/>',
  news: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9h3v6H7zM13 9h4M13 12h4M13 15h3"/>',
  debate: '<path d="M5 5h9a3 3 0 0 1 3 3v5a3 3 0 0 1-3 3H9l-4 3v-3.3A3 3 0 0 1 3 13V8a3 3 0 0 1 2-3Z"/><path d="M8 10h6M8 13h4"/>'
}[name];
---
<svg class:list={["icon", `icon--${name}`]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths} />
