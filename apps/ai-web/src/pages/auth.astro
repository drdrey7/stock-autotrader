---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Account — AI Web" description="Sign in or create an AI Web research workspace.">
  <div class="auth-shell"><div class="auth-aside"><p class="eyebrow"><span class="eyebrow-dot"></span> Your research space</p><h1>Keep the<br /><em>thinking</em><br />together.</h1><p>Save your AI analysis history and keep your research workflow in one focused place.</p></div><section class="auth-card" aria-labelledby="auth-title"><div class="auth-tabs"><button class="is-active" type="button" data-auth-mode="sign-in">Sign in</button><button type="button" data-auth-mode="sign-up">Create account</button></div><h2 id="auth-title">Welcome back</h2><p class="auth-subtitle" data-auth-subtitle>Sign in to open your workspace.</p><form data-auth-form><div class="field" data-name-field hidden><label for="auth-name">Name</label><input id="auth-name" name="name" type="text" autocomplete="name" /></div><div class="field"><label for="auth-email">Email</label><input id="auth-email" name="email" type="email" autocomplete="email" required /></div><div class="field"><label for="auth-password">Password</label><input id="auth-password" name="password" type="password" minlength="8" autocomplete="current-password" required /></div><button class="button button--primary button--full" type="submit" data-auth-submit>Sign in <span aria-hidden="true">↗</span></button><p class="form-message" data-auth-message aria-live="polite"></p></form><p class="auth-disclaimer">By continuing, you’re using a research tool for informational and educational purposes.</p></section></div>
</BaseLayout>
