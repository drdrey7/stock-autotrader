---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
const { title = "AI Web — Multi-agent stock analysis", description = "A clear, multi-agent research workspace for understanding public companies.", eyebrow = "AI Web" } = Astro.props;
const path = Astro.url.pathname;
const isApp = path.startsWith("/app");
if (isApp || path.startsWith("/auth")) { Astro.response.headers.set("cache-control", "no-store"); Astro.response.headers.set("vary", "Cookie"); }
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" /><meta name="description" content={description} /><meta name="theme-color" content="#030811" /><title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>(() => { const saved = localStorage.getItem("ai-web-theme"); document.documentElement.dataset.theme = saved === "light" || saved === "dark" ? saved : "dark"; })();</script>
  </head>
  <body class:list={{ "is-app-page": isApp }}>
    <div class="site-noise" aria-hidden="true"></div><div class="site-stars" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="AI Web home"><svg class="brand-mark" viewBox="0 0 30 30" fill="none" aria-hidden="true"><path d="M15 3.5a11.5 11.5 0 1 0 11.5 11.5"/><path d="M5.1 9.2A11.5 11.5 0 0 1 24.9 20.8"/><circle cx="15" cy="15" r="3.1" fill="currentColor" stroke="none"/></svg><span>{eyebrow}</span></a>
      <nav class="desktop-nav" aria-label="Primary navigation"><a href="/#how-it-works">How it works</a><a href="/pricing">Pricing</a><a href="/#research-team">Research team</a></nav>
      <div class="header-actions"><div class="theme-picker" aria-label="Theme"><button type="button" data-theme-choice="light" aria-label="Use light theme" title="Light theme"><Icon name="sun" size={15} /></button><button type="button" data-theme-choice="dark" aria-label="Use dark theme" title="Dark theme"><Icon name="moon" size={15} /></button></div><a class="account-link" href={isApp ? "/auth" : "/app"} aria-label="Open account or workspace" data-account-link><span class="account-avatar"><Icon name="user" size={17} /></span><span class="account-label" data-auth-state>Sign in</span></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle><span class="sr-only">Open menu</span><Icon name="menu" size={20} /></button></div>
    </header>
    <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden><a href="/#how-it-works">How it works</a><a href="/pricing">Pricing</a><a href="/#research-team">Research team</a><a href="/app">Workspace</a></div>
    <main><slot /></main>
    <footer class="site-footer"><div class="footer-brand">AI Web</div><p>Research tools for clearer market thinking.</p><div class="footer-links"><a href="/pricing">Pricing</a><a href="/auth">Account</a><a href="/">Home</a></div><small>General market research for informational and educational purposes. Not investment advice.</small></footer>
    <script src="../scripts/site.js"></script>
  </body>
</html>
