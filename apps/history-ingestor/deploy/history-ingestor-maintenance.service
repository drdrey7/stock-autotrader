# History ingestor weekly maintenance — recurring service (documented install).
#
# MAINTENANCE HAS STRICT PRIORITY over bootstrap. It runs weekly (Monday
# 07:00 UTC), fetches TIME_SERIES_WEEKLY for the just-closed week and rolls
# every symbol's technical_metrics anchor forward. It never depends on split
# reconciliation (separate low-frequency job) and never blocks on it.

[Unit]
Description=Stock Autotrader weekly history maintenance (Alpha Vantage, priority over bootstrap)
After=network-online.target
Wants=network-online.target
Before=history-ingestor-bootstrap.service history-ingestor-reconcile-split.service

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/opt/stock-autotrader/apps/history-ingestor
Environment=PYTHONPATH=/opt/stock-autotrader/apps/history-ingestor
EnvironmentFile=/etc/stock-autotrader/alpha-vantage.env
EnvironmentFile=/etc/stock-autotrader/cloudflare.env
Environment=HISTORY_INGESTOR_STATE=/var/lib/history-ingestor/checkpoint.json
Environment=HISTORY_INGESTOR_MAINTENANCE_STATE=/var/lib/history-ingestor/maintenance.json
StateDirectory=history-ingestor
ExecStart=/usr/bin/flock /var/lib/history-ingestor/run.lock /usr/bin/python3 -m history_ingestor maintenance
# Protect like the quote-ingestor service: no new privileges, read-only home,
# no capabilities. The D1 writes go over HTTPS to the Cloudflare API.
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
# One-shot; the timer drives cadence. Restart only on transient glitches.
# IMPORTANT: a provider QUOTA-exhausted run exits 0 (expected partial
# completion) — it never triggers Restart=on-failure, so there is no 120s
# retry loop against an exhausted daily quota. Non-zero exits are reserved
# for real failures (config error / corrupted state).
Restart=on-failure
RestartSec=120
# Hard cap so a pathological provider loop can never run the clock out.
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
