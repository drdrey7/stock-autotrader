# History ingestor weekly maintenance — recurring service (documented install).

[Unit]
Description=Stock Autotrader weekly history maintenance (Alpha Vantage)
After=network-online.target history-ingestor-bootstrap.service
Wants=network-online.target
Before=history-ingestor-due-split.service

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/projects/stock-autotrader/apps/history-ingestor
EnvironmentFile=/etc/stock-autotrader/alpha-vantage.env
EnvironmentFile=/etc/stock-autotrader/cloudflare.env
ExecStart=/usr/bin/python3 -m history_ingestor maintenance
# Protect like the quote-ingestor service: no new privileges, read-only home,
# no capabilities. The D1 writes go over HTTPS to the Cloudflare API.
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
# One-shot; the timer drives cadence. Restart only on transient glitches.
# IMPORTANT: a provider QUOTA-exhausted run exits 0 (expected partial
# completion) — it never triggers Restart=on-failure, so there is no 120s
# retry loop against an exhausted daily quota. Non-zero exits are reserved
# for real failures (config error / corrupted state).
Restart=on-failure
RestartSec=120
# Hard cap so a pathological provider loop can never run the clock out.
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
