# Daily zero-provider due-split reconciliation cadence.
#
# 06:00 UTC = 02:00 ET, well before the US market open and before the Monday
# 07:00 WEEKLY maintenance. Reads stored split_events, applies only newly-
# effective splits, updates the affected weekly history and technical_metrics
# — all from stored RAW data, ZERO Alpha Vantage requests.
#
# Runs Mon-Sat (NOT Sunday). Monday is the key pass: it applies the split that
# Sunday's reconcile-splits just discovered (announced effective Monday) BEFORE
# the 07:00 WEEKLY maintenance, so the WEEKLY refresh writes the new week and
# recomputes metrics on the already split-adjusted scale.
# Tuesday-Saturday are zero-write no-op unless a catch-up split needs applying.
# The random delay spreads load.
[Unit]
Description=Daily due-split reconciliation (zero provider, Mon-Sat before Monday maintenance)

[Timer]
OnCalendar=Mon..Sat *-*-* 06:00:00 UTC
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
