# Daily zero-provider due-split reconciliation cadence.
#
# 06:00 UTC (before the Monday maintenance window and US market open). The
# daily check reads stored split_events, applies only newly-effective splits,
# updates affected weekly history and technical_metrics — ZERO Alpha Vantage
# requests.
#
# Monday is intentional: this zero-provider job must apply a future-dated
# Monday split before the 07:00 UTC weekly provider refresh. Tue-Sat keeps the
# catch-up behavior. The random delay stays below the maintenance window; both
# services also share the same flock.
[Unit]
Description=Daily due-split reconciliation (zero provider)

[Timer]
OnCalendar=Mon..Sat *-*-* 06:00:00 UTC
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
