# Daily ZERO-PROVIDER due-split reconciliation — recurring service.
#
# Runs at 06:00 UTC Mon-Sat (before the US market open). On Monday it applies
# the split discovered by Sunday's reconcile-splits (announced effective Monday)
# BEFORE the 07:00 WEEKLY maintenance, so maintenance refreshes the new week
# and recomputes metrics on the already split-adjusted scale. Reads stored
# split_events from D1 and applies them to affected weekly history +
# technical_metrics — entirely from stored RAW data, ZERO Alpha Vantage
# requests.
#
# Normally a no-op (no writes). Idempotent. Does not affect Finnhub service.
[Unit]
Description=Stock Autotrader daily due-split reconciliation (zero provider, before maintenance)
After=network-online.target
Before=history-ingestor-maintenance.service
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/opt/stock-autotrader/apps/history-ingestor
Environment=PYTHONPATH=/opt/stock-autotrader/apps/history-ingestor
EnvironmentFile=/etc/stock-autotrader/cloudflare.env
EnvironmentFile=/etc/stock-autotrader/alpha-vantage.env
Environment=HISTORY_INGESTOR_STATE=/var/lib/history-ingestor/checkpoint.json
Environment=HISTORY_INGESTOR_MAINTENANCE_STATE=/var/lib/history-ingestor/maintenance.json
StateDirectory=history-ingestor
ExecStart=/usr/bin/flock /var/lib/history-ingestor/run.lock /usr/bin/python3 -m history_ingestor apply-due-splits
# Same protection as the weekly maintenance service.
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
# Exit 0 on success or quota (no retry loop). Non-zero only on real failure.
Restart=on-failure
RestartSec=120
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
