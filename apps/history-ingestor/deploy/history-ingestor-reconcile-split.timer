# LOW-FREQUENCY provider SPLITS reconciliation — TUE..SAT 09:00 UTC.
#
# This is the SEPARATE split-discovery responsibility, independent of the
# weekly SMA refresh. The 50-symbol universe is processed in durable capped
# slices across the five residual days: 10 SPLITS requests/day => one complete
# reconciliation pass per week under normal conditions.
#
# ORDERING (MAINTENANCE HAS ABSOLUTE PRIORITY):
#   maintenance  -- daily 07:00 UTC (weekly refresh on Monday; carryover first)
#   bootstrap    -- daily 08:00 UTC (residual, exact HTTP-capped)
#   reconcile    -- Tue..Sat 09:00 UTC (10-request durable slice)
#   due-split    -- Tue..Sat 13:10 UTC (zero-provider)
#
# Monday is reserved entirely for the primary 200W WEEKLY refresh, which may
# consume the full two-key free-tier budget (25/key, 50/day total). Tue..Sat,
# maintenance still runs first and gets any quota it needs for carryover; only
# afterwards can bootstrap/reconciliation use residual capacity.
#
# Persistent=false: a missed slice is NOT auto-caught-up at boot into a due
# maintenance window. The durable reconcile cursor simply resumes on the next
# scheduled residual day.
[Unit]
Description=Stock Autotrader SPLITS reconciliation (Tue-Sat residual slices; non-persistent)

[Timer]
OnCalendar=Tue..Sat *-*-* 09:00:00 UTC
RandomizedDelaySec=15m
Persistent=false

[Install]
WantedBy=timers.target
