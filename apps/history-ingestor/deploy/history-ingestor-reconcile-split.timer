# LOW-FREQUENCY provider SPLITS reconciliation — MONDAY 09:00 UTC (after maintenance).
#
# This is the SEPARATE split-forwarding responsibility, independent of the
# weekly SMA refresh. Stock splits are rare, so the provider SPLITS check runs
# once per week — never daily. It fetches SPLITS per symbol, compares against
# the durable split_events store and rewrites ONLY the affected symbol's
# history/metrics on change.
#
# ORDERING (MAINTENANCE HAS ABSOLUTE PRIORITY):
#   maintenance  -- daily 07:00 UTC (weekly refresh on Monday; Tue-Sat noop when complete)
#   bootstrap    -- daily 08:00 UTC (residual, request-capped)
#   reconcile    -- Monday 09:00 UTC (this job; AFTER maintenance/bootstrap)
#   due-split    -- Tue-Sat 13:10 UTC (zero-provider)
# No two provider-fetching jobs share a UTC slot, and this job never runs
# before maintenance on any day, so it can never consume shared Alpha Vantage
# quota ahead of the weekly SMA refresh.
#
# Persistent=false: a missed run is NOT auto-caught-up at boot. Splits are rare
# and the daily zero-provider apply-due-splits keeps stored split_events applied
# regardless, so a permanent (non-persistent) schedule is the simplest way to
# guarantee this job can never preempt maintenance after a downtime.
[Unit]
Description=Stock Autotrader SPLITS reconciliation (weekly; after maintenance; non-persistent)

[Timer]
OnCalendar=Mon *-*-* 09:00:00 UTC
RandomizedDelaySec=15m
Persistent=false

[Install]
WantedBy=timers.target