# LOW-FREQUENCY provider SPLITS reconciliation — twice monthly at 09:00 UTC.
#
# This is the SEPARATE split-discovery responsibility, independent of the
# weekly SMA refresh. Splits are rare for the 50-symbol Core Universe, so a
# full provider scan every day is unnecessary. The job runs on the 1st and
# 15th of each month and resumes from its durable checkpoint if provider quota
# is unavailable.
#
# ORDERING (MAINTENANCE HAS ABSOLUTE PRIORITY):
#   maintenance  -- daily 07:00 UTC (weekly refresh on Monday; carryover first)
#   bootstrap    -- daily 08:00 UTC while bootstrap is incomplete only
#   reconcile    -- 1st + 15th 09:00 UTC (bounded residual split scan)
#   due-split    -- Tue..Sat 13:10 UTC (zero-provider)
#
# A healthy Monday maintenance refreshes the 200W basis once per week. The
# reconciliation job is intentionally infrequent because split discovery does
# not need daily polling. It shares the provider ledger, so maintenance always
# wins if both need quota.
#
# Persistent=false: a missed scan is NOT auto-caught-up at boot into a due
# maintenance window. The durable reconcile cursor resumes on the next
# scheduled scan.
[Unit]
Description=Stock Autotrader SPLITS reconciliation (twice-monthly bounded residual scan)

[Timer]
OnCalendar=*-*-01,15 09:00:00 UTC
RandomizedDelaySec=15m
Persistent=false

[Install]
WantedBy=timers.target
