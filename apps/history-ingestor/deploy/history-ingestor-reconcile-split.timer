# Sunday provider SPLITS discovery cadence.
#
# The SPLITS scan runs every Sunday at 09:00 UTC — one day ahead of the
# Monday WEEKLY maintenance — so a Monday-effective split (as announced by
# Alpha Vantage) is discovered, persisted to split_events and left for the
# Monday 06:00 apply-due-splits pass to apply before the WEEKLY refresh.
# It therefore does NOT compete with Monday's ~50-request WEEKLY run.
#
# ORDERING (weekly, with Monday effective splits in mind):
#   Sat  ------- apply-due-splits  -- 06:00 (zero-provider)
#   Sun  09:00  reconcile-splits  -- bounded SPLITS discovery (<=50 requests,
#                                    residual shared quota only)
#   Mon  06:00  apply-due-splits  -- applies the just-discovered Monday-effective
#                                    split to RAW history + metrics (zero-provider)
#   Mon  07:00  maintenance       -- WEEKLY refresh on the already-adjusted scale
#
# Persistent=false: a missed Sunday scan is NOT auto-caught-up at boot into the
# Monday maintenance window. The durable reconcile cursor resumes on the next
# Sunday scan.
[Unit]
Description=Stock Autotrader SPLITS reconciliation (weekly Sunday bounded residual scan)

[Timer]
OnCalendar=Sun *-*-* 09:00:00 UTC
RandomizedDelaySec=15m
Persistent=false

[Install]
WantedBy=timers.target
