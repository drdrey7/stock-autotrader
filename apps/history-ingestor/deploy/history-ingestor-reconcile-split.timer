# Weekly provider SPLITS reconciliation — Sunday full-universe discovery.
#
# This is the SEPARATE split-discovery responsibility, independent of the
# weekly SMA refresh. Splits are rare for the 50-symbol Core Universe, so a
# provider scan every day is unnecessary. The job runs on Sunday and resumes
# from its durable checkpoint if provider quota is unavailable.
#
# ORDERING (MAINTENANCE HAS ABSOLUTE PRIORITY):
#   maintenance  -- daily 07:00 UTC (weekly refresh on Monday; carryover first)
#   bootstrap    -- daily 08:00 UTC while bootstrap is incomplete only
#   due-split    -- Mon..Sat 06:00 UTC (zero-provider; before maintenance)
#   reconcile    -- Sunday 09:00 UTC (bounded full-universe scan)
#
# Sunday is deliberate: it does not compete with Monday's weekly provider
# refresh and stores future-dated events before the Monday due-split pass.
#
# Persistent=false: a missed scan is NOT auto-caught-up at boot into a due
# maintenance window. The durable reconcile cursor resumes on the next
# scheduled scan.
[Unit]
Description=Stock Autotrader SPLITS reconciliation (Sunday bounded full-universe scan)

[Timer]
OnCalendar=Sun *-*-* 09:00:00 UTC
RandomizedDelaySec=15m
Persistent=false

[Install]
WantedBy=timers.target
