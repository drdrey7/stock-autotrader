# Daily maintenance cadence (07:00 UTC, before NY market open).
#
# SUNDAY 07:00 UTC -> SPLITS reconciliation pass.
# MONDAY 07:00 UTC -> WEEKLY refresh pass for the just-closed week.
# TUE-SAT 07:00 UTC -> catch-up if the weekly phase remains incomplete.
# Completed/idempotent work performs ZERO provider calls.
#
# The bootstrap timer runs earlier at 06:00 UTC while initial coverage is
# incomplete. Service ordering prevents overlap during persistent catch-up.
[Unit]
Description=Stock Autotrader history maintenance (daily; Sun SPLITS / Mon-Sat WEEKLY catch-up)

[Timer]
OnCalendar=*-*-* 07:00:00 UTC
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
