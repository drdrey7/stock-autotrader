# Weekly maintenance cadence.
#
# SUNDAY 05:10 UTC -> SPLITS reconciliation pass (the week that closed on
#                    Friday is the cycle target; split history is compared and
#                    reconciled, changes trigger a historical rewrite).
# MONDAY 05:10 UTC -> WEEKLY refresh pass (the just-closed week's bucket is
#                    storable only once Monday begins in New York; 05:10 UTC
#                    is Sunday night / early-Monday ET inside the new NY week
#                    — the deterministic fetch window that keeps the
#                    in-progress week out).
#
# A single service unit runs both: the durable cycle checkpoint in D1 decides
# which phase to work, and a quota-blocked Sunday simply resumes on the next
# permitted run. The random delay spreads load and avoids provider fan-out
# peaks. Persistent=true catches up after a long outage.
[Unit]
Description=Weekly Stock Autotrader history maintenance (Sun SPLITS / Mon WEEKLY)

[Timer]
OnCalendar=Sun *-*-* 05:10:00
OnCalendar=Mon *-*-* 05:10:00
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
