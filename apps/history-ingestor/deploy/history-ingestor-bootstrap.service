# Residual bootstrap — recurring daily, AFTER maintenance, request-capped.
#
# Runs strictly AFTER the priority weekly maintenance so it can never consume
# the day's Alpha Vantage quota ahead of the weekly SMA refresh. A hard daily
# cap (BOOTSTRAP_MAX_REQUESTS_PER_DAY, default 6) is applied by the CLI so one
# problem symbol cannot exhaust quota. Checkpoint stays honest until 50/50.
# On successful exit, OnSuccess starts a separate root-only completion gate;
# that unit has no EnvironmentFile and disables this timer only at 50/50.
# Production checkout: /opt/stock-autotrader (origin/main only).

[Unit]
Description=Stock Autotrader history bootstrap (daily residual run; after maintenance; request-capped)
After=network-online.target history-ingestor-maintenance.service
Wants=network-online.target
OnSuccess=history-ingestor-bootstrap-maybe-disable.service

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/opt/stock-autotrader/apps/history-ingestor
Environment=PYTHONPATH=/opt/stock-autotrader/apps/history-ingestor
EnvironmentFile=/etc/stock-autotrader/alpha-vantage.env
EnvironmentFile=/etc/stock-autotrader/cloudflare.env
Environment=HISTORY_INGESTOR_STATE=/var/lib/history-ingestor/checkpoint.json
StateDirectory=history-ingestor
ExecStart=/usr/bin/flock /var/lib/history-ingestor/run.lock /usr/bin/python3 -m history_ingestor bootstrap
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
Restart=on-failure
RestartSec=120
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
