# LOW-FREQUENCY provider SPLITS reconciliation — recurring residual service.
#
# Decoupled from weekly maintenance so split discovery NEVER blocks or starves
# the WEEKLY SMA refresh. Shares the same Alpha Vantage per-key ledger.
#
# QUOTA: provider entitlement is 25 requests/day per key; with two keys that is
# 50/day total. Monday is reserved for the 50-symbol WEEKLY maintenance pass.
# Tue..Sat this service runs after maintenance and bootstrap, processing at most
# 10 SPLITS requests per invocation. Five durable slices cover the 50-symbol
# universe once per week under normal conditions while leaving substantial
# residual quota. If maintenance carries over, it still runs first and this job
# simply gets less/no shared provider budget and resumes next residual day.
[Unit]
Description=Stock Autotrader SPLITS reconciliation (bounded residual provider check)
After=network-online.target history-ingestor-maintenance.service history-ingestor-bootstrap.service
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/opt/stock-autotrader/apps/history-ingestor
Environment=PYTHONPATH=/opt/stock-autotrader/apps/history-ingestor
EnvironmentFile=/etc/stock-autotrader/alpha-vantage.env
EnvironmentFile=/etc/stock-autotrader/cloudflare.env
Environment=HISTORY_INGESTOR_STATE=/var/lib/history-ingestor/checkpoint.json
Environment=HISTORY_INGESTOR_MAINTENANCE_STATE=/var/lib/history-ingestor/maintenance.json
# Exactly one normal weekly pass: 10 requests/day * Tue..Sat = 50 symbols.
Environment=RECONCILE_SPLITS_MAX_REQUESTS=10
StateDirectory=history-ingestor
ExecStart=/usr/bin/flock /var/lib/history-ingestor/run.lock /usr/bin/python3 -m history_ingestor reconcile-splits
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
# Quota/throttle exits 0 (expected partial completion) — no retry loop.
Restart=on-failure
RestartSec=120
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
