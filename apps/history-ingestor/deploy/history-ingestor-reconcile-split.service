# LOW-FREQUENCY provider SPLITS reconciliation — bounded residual service.
#
# Decoupled from weekly maintenance so split discovery NEVER blocks or starves
# the WEEKLY SMA refresh. Shares the same Alpha Vantage per-key ledger.
#
# QUOTA: provider entitlement is 25 requests/day per key; with two keys that is
# 50/day total. This service is scheduled only on the 1st and 15th of each month,
# after maintenance and (while it still exists) bootstrap. It may use at most 50
# provider HTTP requests in one invocation, but the shared provider ledger means
# it can consume only the real residual budget left that day. If maintenance or
# bootstrap already used quota, reconciliation stops safely and resumes from its
# durable cursor on the next scheduled scan.
[Unit]
Description=Stock Autotrader SPLITS reconciliation (twice-monthly bounded residual provider check)
After=network-online.target history-ingestor-maintenance.service history-ingestor-bootstrap.service
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/opt/stock-autotrader/apps/history-ingestor
Environment=PYTHONPATH=/opt/stock-autotrader/apps/history-ingestor
EnvironmentFile=/etc/stock-autotrader/alpha-vantage.env
EnvironmentFile=/etc/stock-autotrader/cloudflare.env
Environment=HISTORY_INGESTOR_STATE=/var/lib/history-ingestor/checkpoint.json
Environment=HISTORY_INGESTOR_MAINTENANCE_STATE=/var/lib/history-ingestor/maintenance.json
# One provider request per Core Universe symbol. The real ceiling is still the
# shared per-key daily ledger (25/key); this explicit cap prevents unbounded work.
Environment=RECONCILE_SPLITS_MAX_REQUESTS=50
StateDirectory=history-ingestor
ExecStart=/usr/bin/flock /var/lib/history-ingestor/run.lock /usr/bin/python3 -m history_ingestor reconcile-splits
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
# Quota/throttle exits 0 (expected partial completion) — no retry loop.
Restart=on-failure
RestartSec=120
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
