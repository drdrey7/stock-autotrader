# Fundamentals maintenance — recurring service (documented install).

[Unit]
Description=Stock Autotrader daily fundamentals maintenance (SEC EDGAR)
After=network-online.target fundamentals-ingestor-bootstrap.service
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/projects/stock-autotrader/apps/fundamentals-ingestor
EnvironmentFile=/etc/stock-autotrader/cloudflare.env
Environment=FUNDAMENTALS_INGESTOR_STATE=/var/lib/fundamentals-ingestor/maintenance.json
StateDirectory=fundamentals-ingestor
ExecStart=/usr/bin/flock /var/lib/fundamentals-ingestor/run.lock /usr/bin/npx tsx src/cli.ts maintenance --all-core --remote --apply
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=
Restart=on-failure
RestartSec=120
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
