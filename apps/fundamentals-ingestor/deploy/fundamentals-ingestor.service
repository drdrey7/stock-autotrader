[Unit]
Description=Stock Autotrader simple fundamentals snapshot ingestor
Documentation=https://github.com/drdrey7/stock-autotrader
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/projects/stock-autotrader/apps/fundamentals-ingestor
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/stock-autotrader/finnhub.env
EnvironmentFile=/etc/stock-autotrader/cloudflare.env
EnvironmentFile=/etc/stock-autotrader/edgar.env
StateDirectory=stock-autotrader-fundamentals
ExecStart=/usr/bin/flock /var/lib/stock-autotrader-fundamentals/run.lock /opt/stock-autotrader-fundamentals/bin/python -m fundamentals_ingestor
TimeoutStartSec=3600
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
CapabilityBoundingSet=
AmbientCapabilities=
