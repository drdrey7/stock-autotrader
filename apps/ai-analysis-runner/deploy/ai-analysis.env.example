# Install as /etc/stock-autotrader/ai-analysis.env, owned by hermes:hermes, mode 0600.
# Queue token should have only the Cloudflare account Queues permission it needs.
CLOUDFLARE_QUEUES_API_TOKEN=replace-with-queues-token
CLOUDFLARE_AI_QUEUE_ID=replace-with-queue-id

# OpenRouter is the production provider. Supported primary values are google,
# openai, openrouter, and openai_compatible. The pinned TradingAgents release
# supplies OpenRouter's HTTPS endpoint when no backend URL is configured.
TRADINGAGENTS_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-openrouter-key
TRADINGAGENTS_QUICK_THINK_LLM=openai/gpt-5.4-mini
TRADINGAGENTS_DEEP_THINK_LLM=openai/gpt-5.5

# Google example:
# TRADINGAGENTS_LLM_PROVIDER=google
# GOOGLE_API_KEY=replace-with-google-key
# TRADINGAGENTS_QUICK_THINK_LLM=gemini-3.1-flash-lite
# TRADINGAGENTS_DEEP_THINK_LLM=gemini-3.5-flash

# OpenAI-compatible example (do not alias this key to OPENAI_API_KEY):
# TRADINGAGENTS_LLM_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_API_KEY=replace-with-compatible-provider-key
# TRADINGAGENTS_LLM_BACKEND_URL=https://gateway.example/v1
# TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4-flash
# TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4-flash

# The OpenAI fallback is disabled by default and runs at most once after a
# retryable Google failure. Only configure this key when explicitly enabling it.
AI_ANALYSIS_OPENAI_FALLBACK_ENABLED=false
# OPENAI_API_KEY=replace-with-openai-key
AI_ANALYSIS_OPENAI_QUICK_MODEL=gpt-5.4-mini
AI_ANALYSIS_OPENAI_DEEP_MODEL=gpt-5.5

# Optional upstream macro-data key. TradingAgents uses FRED for macro tools.
# FRED_API_KEY=replace-with-fred-key

# Operational bounds. Queue visibility must exceed the longest expected run.
AI_ANALYSIS_QUEUE_VISIBILITY_TIMEOUT_MS=300000
AI_ANALYSIS_QUEUE_REQUEST_TIMEOUT_SECONDS=30
AI_ANALYSIS_D1_REQUEST_TIMEOUT_SECONDS=30
AI_ANALYSIS_HTTP_MAX_ATTEMPTS=3
AI_ANALYSIS_MAX_ATTEMPTS=3
AI_ANALYSIS_RETRY_DELAY_SECONDS=60
AI_ANALYSIS_HEARTBEAT_INTERVAL_SECONDS=60
AI_ANALYSIS_STALE_LEASE_SECONDS=300
AI_ANALYSIS_EMPTY_POLL_MIN_SECONDS=1
AI_ANALYSIS_EMPTY_POLL_MAX_SECONDS=10
AI_ANALYSIS_RESULT_MAX_BYTES=1500000
AI_ANALYSIS_VALID_DAYS=5
TRADINGAGENTS_LLM_MAX_RETRIES=1
AI_ANALYSIS_ENGINE_TIMEOUT_SECONDS=300
AI_ANALYSIS_STATE_DIR=/var/lib/ai-analysis-runner
