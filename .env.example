# Public web app (PR #2: D1 + read-only API).
# VITE_DEMO_MODE=false reads from the public API served by the same Worker (/api/*),
# backed by D1. Leave it true to run fully on central demo data (no API needed).
# VITE_API_BASE_URL is optional — blank means same-origin (/api/*).
VITE_API_BASE_URL=
VITE_DEMO_MODE=false

# Earnings provider secrets belong only to the production Worker, never to
# frontend/Vite environment variables. Configure them with Wrangler.
# npx wrangler secret put FINNHUB_API_KEY --config apps/web/wrangler.jsonc
# npx wrangler secret put SEC_USER_AGENT --config apps/web/wrangler.jsonc

# Stripe Billing configuration belongs only to the Worker. See
# docs/stripe-billing.md. Use test-mode values locally and restricted API keys.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=
# STRIPE_PRICE_ANNUAL=
# STRIPE_CREDIT_PACKS=  # JSON array of credit packs: [{"credits":5,"priceId":"..."},{"credits":10,"priceId":"..."}]

# --- VPS fundamentals-ingestor (in /etc/stock-autotrader/finnhub.env). ---
# ExchangeRate-API Free plan key (keyed FX endpoint for instrument/currency
# normalization). Required by the ingestor; never log or commit it.
# EXCHANGE_RATE_API_KEY=
