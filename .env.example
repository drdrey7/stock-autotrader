# Public web app (PR #2: D1 + read-only API).
# VITE_DEMO_MODE=false reads from the public API served by the same Worker (/api/*),
# backed by D1. Leave it true to run fully on central demo data (no API needed).
# VITE_API_BASE_URL is optional — blank means same-origin (/api/*).
VITE_API_BASE_URL=
VITE_DEMO_MODE=false

# Optional Worker secrets: configure with Wrangler, never commit values.
# Without FMP_API_KEY the SEC-only adapter remains functional for official
# historical filings; future schedules/consensus stay Not published.
# FMP_API_KEY=
# SEC_USER_AGENT=StockAutotrader/1.0 (+https://github.com/drdrey7/stock-autotrader)
