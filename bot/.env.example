# Local-only runtime configuration. Copy to bot/.env and fill in values.
# NEVER commit real secrets — .env is gitignored.

# runtime
BOT_ENV=dev
LOG_LEVEL=INFO

# scheduler (America/New_York)
BOT_TIMEZONE=America/New_York
PRE_MARKET_SCAN_CRON=30 7 * * mon-fri
POST_CLOSE_SCAN_CRON=30 16 * * mon-fri
DATA_REFRESH_CRON=15 * * * *
HEALTH_CHECK_CRON=*/5 * * * *

# market data (CSV provider; universe.csv + bars.csv)
# Optional path overrides; by default these follow DATA_DIR.
# MARKET_DATA_DIR=/path/to/runtime-data/market
# MARKET_DATA_CACHE=/path/to/runtime-data/market/latest.json
MARKET_MIN_PRICE=5
MARKET_MIN_AVG_VOLUME=250000
MARKET_MIN_MARKET_CAP=300000000
MARKET_MAX_STALENESS_DAYS=3

# publishing (PR #3 ingest)
INGEST_URL=https://stock-autotrader-web.barroso-labs.workers.dev/ingest/events
INGEST_SECRET=

# Operational alerts: delivered by a Hermes cron (profile default) to the
# already-configured Telegram channel — no credentials needed here.
